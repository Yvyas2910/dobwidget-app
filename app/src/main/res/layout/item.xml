<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingTop="3dp" android:paddingBottom="3dp">
    <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:textColor="#111111" android:textSize="15sp" />
    <TextView android:id="@+id/std" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#1565C0" android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
